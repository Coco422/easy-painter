# ============================================
# 基础设施连接（改后需重启 api + worker 容器）
# ============================================
APP_PORT=8080

POSTGRES_DB=easy_painter
POSTGRES_USER=easy_painter
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+psycopg://easy_painter:change-me-postgres-password@postgres:5432/easy_painter

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# RustFS 对象存储；MINIO_* 配置名为兼容旧环境而保留。
# ROOT_USER/PASSWORD 映射到 RustFS 的 ACCESS_KEY/SECRET_KEY。
# 首次安装时应用 ACCESS_KEY/SECRET_KEY 与 ROOT_USER/PASSWORD 保持一致。
MINIO_ROOT_USER=easy-painter-storage
MINIO_ROOT_PASSWORD=change-me-storage-password
MINIO_ENDPOINT=rustfs:9000
MINIO_ACCESS_KEY=easy-painter-storage
MINIO_SECRET_KEY=change-me-storage-password
MINIO_BUCKET=easy-painter-media
MINIO_REFERENCE_BUCKET=easy-painter-references
MINIO_SECURE=false

# ============================================
# 应用配置（改后需重启 api + worker 容器）
# ============================================
APP_NAME=easy-painter-api
# 代理站设为 false，隐藏主站推广外链与仓库版本入口。
RELATED_SITES_ENABLED=true
SITE_NAME=一丝绘画站
APP_ENV=production
PROMPT_MAX_LENGTH=4000
POLLING_INTERVAL_MS=2000
GENERATION_JOB_STALE_SECONDS=2700
GENERATION_QUEUE_STALE_SECONDS=900
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100
RECONCILIATION_INTERVAL_SECONDS=300
WATCHDOG_INTERVAL_SECONDS=30
DISPATCHER_HEARTBEAT_TTL_SECONDS=30
MEDIA_TOKEN_TTL_SECONDS=3600
# 首次上线时保持 false；媒体私有链路与外链社区图片迁移验收后再启用。
MEDIA_CLEANUP_ENABLED=false
MEDIA_CLEANUP_INTERVAL_SECONDS=60
MEDIA_CLEANUP_BATCH_SIZE=100
# Anti-abuse burst threshold per account in one second; not a generation quota.
GENERATION_ABUSE_BURST_LIMIT=60
EXAMPLE_PROMPTS_JSON=["春天清晨的湖边小镇，薄雾、樱花和温暖阳光，治愈系插画风格","一只坐在月球咖啡馆里的橘猫，窗外是星云与地球，梦幻绘本风","海边黄昏的小火车站，远处灯塔亮起，柔和水彩质感","雨后古城的小巷，青石路反射暖色灯光，电影感场景设计"]
ALLOWED_ORIGINS_JSON=["http://localhost:5173","http://127.0.0.1:5173"]

# ============================================
# 认证配置（改后需重启 api 容器）
# ============================================
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440
ADMIN_SECRET_KEY=change-me-admin-secret
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=change-me-password
DEFAULT_EMAIL=
REGISTRATION_ENABLED=true

# ============================================
# 邮件与验证码（注册 / 忘记密码 / 绑定邮箱）
# 587 通常使用 STARTTLS：SMTP_USE_TLS=true、SMTP_USE_SSL=false
# 465 通常使用 SSL：SMTP_USE_TLS=false、SMTP_USE_SSL=true
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=一丝绘画站
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_CODE_EXPIRE_SECONDS=600
# 同一邮箱两次发送的最短间隔；服务端使用 Redis 原子锁执行
EMAIL_CODE_COOLDOWN_SECONDS=60
# 同一邮箱或登录用户在短周期内的发送上限
EMAIL_CODE_RATE_LIMIT_COUNT=3
EMAIL_CODE_RATE_LIMIT_WINDOW_SECONDS=600
# 同一邮箱或登录用户的日级发送上限
EMAIL_CODE_DAILY_LIMIT_COUNT=10
EMAIL_CODE_DAILY_LIMIT_WINDOW_SECONDS=86400
# 单个来源 IP 的短周期与日级发送上限
EMAIL_CODE_IP_RATE_LIMIT_COUNT=15
EMAIL_CODE_IP_DAILY_LIMIT_COUNT=50

# ============================================
# 首次启动播种配置
# 默认只补充缺失配置；已有配置通过管理后台修改
# 显式启用下方同步开关后，环境配置才会覆盖公共模型配置
# ============================================
# PUBLIC_MODELS_JSON 的 id 是前台/数据库使用的公共模型 ID；如与主上游
# /v1/models 返回名不同，可用 upstream_model_id 指定实际请求名。
# 前端默认选中列表里第一个 enabled 的模型（即管理后台 sort_order 最小者），
# DEFAULT_MODEL 目前应用不读取，仅作记录。
DEFAULT_MODEL=gpt-image-2
PUBLIC_MODELS_JSON=[{"id":"gpt-image-2","label":"主用绘图模型","enabled":true,"supports_reference_image":true,"max_reference_images":5,"supported_sizes":[],"credit_cost":2}]
# 默认只在首次播种时生效。设为 true 时会按 PUBLIC_MODELS_JSON 更新/绑定模型，
# 并禁用清单外的模型（不删除记录）；确认清单只含要公开的模型后再开启。
SYNC_PUBLIC_MODELS_FROM_ENV=false
# 上游是 OpenAI 兼容的图片接口：base_url 必须写到 /v1 这一层
# （后端分别拼接 /images/generations、/images/edits，不会自动补 /v1）。
UPSTREAM_BASE_URL=https://your-private-upstream.example.com/v1
UPSTREAM_API_KEY=replace-with-your-private-key
UPSTREAM_PROVIDER_NAME=chatgpt2api（自建）
# 必须长于上游自身的生图轮询超时（例如 chatgpt2api 默认 120 秒），
# 单张图通常 30~600 秒；仓库默认 700 秒，不要调小到 120 秒以下。
UPSTREAM_TIMEOUT_SECONDS=700
# 可选：提高服务端查询 GitHub Release API 的限额；仅保存在服务器 .env 中。
GITHUB_API_TOKEN=
UPSTREAM_DEFAULT_SIZE=auto
UPSTREAM_DEFAULT_QUALITY=high
UPSTREAM_DEFAULT_OUTPUT_FORMAT=jpeg
UPSTREAM_DEFAULT_OUTPUT_COMPRESSION=85
UPSTREAM_DEFAULT_BACKGROUND=auto
UPSTREAM_DEFAULT_MODERATION=auto

# Optional additional OpenAI-compatible provider(s), added without replacing the primary.
# Public model IDs are unique. A fallback entry may reuse a public model ID when
# fallback_for points to it; that entry routes requests without creating a second option.
# API keys remain private in .env and are copied into provider records.
# Add models only after checking their /v1/models names and endpoint capabilities.
ADDITIONAL_UPSTREAMS_JSON=[]
# Example: configure ggwk1 as the fallback for the one public model. Replace the primary model ID below with the ID verified on chatgpt2api.
# ADDITIONAL_UPSTREAMS_JSON=[{"name":"ggwk1（第一第三方）","base_url":"https://www.ggwk1.online/v1","api_key":"replace-with-private-key","timeout_seconds":700,"models":[{"id":"gpt-image-2","label":"备用模型","upstream_model_id":"gpt-image-2","fallback_for":"gpt-image-2","enabled":true,"supports_reference_image":true,"max_reference_images":1,"supported_sizes":[],"credit_cost":2}]}]

# Agent access is disabled when empty. Set the exact external HTTPS endpoint before enabling.
MCP_PUBLIC_URL=

# 在线充值：在管理后台「充值管理」填写商户信息，密钥加密存库。
# 服务器专用加密主密钥；运行 scripts/init-payment-encryption-key.py 初始化，勿更换/丢失。
PAYMENT_CONFIG_ENCRYPTION_KEY=
# 以下仅兼容旧环境；后台保存后以数据库配置为准。新部署留空即可。
# 总开关和套餐默认关闭；网关为 HTTPS 根地址，勿包含 /submit.php 或 /mapi.php。
ZPAY_ENABLED=false
ZPAY_GATEWAY_URL=
ZPAY_MERCHANT_ID=
ZPAY_KEY=
ZPAY_PUBLIC_BASE_URL=
ZPAY_ORDER_TTL_MINUTES=30
